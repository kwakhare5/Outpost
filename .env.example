# Local dev database: Docker container "outpost-db" (Postgres 17), fresh database "outpost".
# Use the user and password the container was created with. To start one if none exists
# (pick your own dev password, then match it below):
#   docker run -d --name outpost-db -e POSTGRES_USER=outpost -e POSTGRES_DB=outpost -e POSTGRES_PASSWORD=CHOOSE_ONE -p 5432:5432 -v outpost_pgdata:/var/lib/postgresql/data postgres:17
DATABASE_URL=postgres://outpost:CHANGE_ME@localhost:5432/outpost
